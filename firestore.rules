rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to get user role
    function getUserRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }
    
    function isAdmin(uid) {
      return getUserRole(uid) == 'admin' || getUserRole(uid) == 'super-admin';
    }
    
    function isSuperAdmin(uid) {
      return getUserRole(uid) == 'super-admin';
    }
    
    function isAdmin_or_UnitHead(uid) {
      return getUserRole(uid) in ['admin', 'super-admin', 'unit-head'];
    }
    
    // USERS COLLECTION
    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      allow read: if isAdmin(request.auth.uid);
      allow update: if request.auth.uid == userId && 
                       !request.resource.data.role.changed;
      allow update: if isAdmin(request.auth.uid);
      allow create: if isSuperAdmin(request.auth.uid);
      allow delete: if isSuperAdmin(request.auth.uid);
    }
    
    // TICKETS COLLECTION
    match /tickets/{ticketId} {
      allow read: if 
        request.auth.uid == resource.data.submittedById ||
        request.auth.uid == resource.data.assignedId ||
        isAdmin_or_UnitHead(request.auth.uid);
      
      allow create: if 
        request.auth.uid == request.resource.data.submittedById &&
        getUserRole(request.auth.uid) in ['student', 'staff'];
      
      allow update: if 
        isAdmin(request.auth.uid) ||
        (getUserRole(request.auth.uid) == 'technician' && 
         request.auth.uid == resource.data.assignedId) ||
        (request.resource.data.comments.size() > resource.data.comments.size());
    }
    
    // NOTIFICATIONS SUBCOLLECTION
    match /notifications/{userId}/items/{notificationId} {
      allow read: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
      allow delete: if request.auth.uid == userId;
      allow create: if false; // Only server (via cloud function) can create
    }
    
    // SETTINGS COLLECTION
    match /settings/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin(request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
